---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import '../styles/pedido-confirmado.css';
import Footer from '../components/Footer.jsx';

const session = Astro.cookies.get('servix_session');

if (!session) {
  return Astro.redirect('/login');
}

const orderId = Astro.url.searchParams.get('id');

if (!orderId) {
  return Astro.redirect('/carrito');
}
---

<Layout>

  <Navbar client:load />

  <main class="confirmacion-page">

    <section class="confirmacion-container">

      <!-- =========================
           ICONO
      ========================== -->

      <div class="confirmacion-icono">
        ✓
      </div>


      <!-- =========================
           MENSAJE
      ========================== -->

      <span class="section-label">
        SERVIX / SOLICITUD RECIBIDA
      </span>

      <h1>
        ¡Solicitud enviada!
      </h1>

      <p class="confirmacion-texto">
        Tu solicitud fue registrada correctamente.
        Nuestro equipo revisará los productos y
        se pondrá en contacto contigo para coordinar
        la entrega.
      </p>


      <!-- =========================
           NUMERO PEDIDO
      ========================== -->

      <div class="pedido-numero">

        <span>
          Número de solicitud
        </span>

        <strong>
          #<span id="order-id">
            {orderId}
          </span>
        </strong>

      </div>


      <!-- =========================
           ESTADO
      ========================== -->

      <div class="estado-pedido">

        <div class="estado-icono">
          ⏳
        </div>

        <div>

          <strong>
            Solicitud pendiente
          </strong>

          <p>
            Estamos revisando tu solicitud.
          </p>

        </div>

      </div>


      <!-- =========================
           BOTONES
      ========================== -->

      <div class="confirmacion-botones">

        <a
          href="/"
          class="btn-principal"
        >
          Volver al inicio
        </a>

        <a
          href="/pedidos"
          class="btn-secundario"
        >
          Ver mis solicitudes
        </a>

      </div>

    </section>

  </main>
<Footer />
</Layout>

