
---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
import '../styles/index.css';
---

<Layout>

  <Navbar client:load />

  <main>

     <!-- MARCAS -->
<section class="brands">

  <div class="brands-track">

    <div class="brand">
      <img src="/assets/molex.avif" alt="Marca 1" />
    </div>

    <div class="brand">
      <img src="/assets/jabil.avif" alt="Marca 2" />
    </div>

    <div class="brand">
      <img src="/assets/rancho.avif" alt="Marca 3" />
    </div>

    <div class="brand">
      <img src="/assets/stra.avif" alt="Marca 4" />
    </div>

    <div class="brand">
      <img src="/assets/cogni.avif" alt="Marca 5" />
    </div>

    <div class="brand">
      <img src="/assets/jabil.avif" alt="Marca 6" />
    </div>


    <!-- REPETICIÓN PARA EL LOOP INFINITO -->

    <div class="brand">
      <img src="/assets/molex.avif" alt="Marca 1" />
    </div>

    <div class="brand">
      <img src="/assets/jabil.avif" alt="Marca 2" />
    </div>

    <div class="brand">
      <img src="/assets/rancho.avif" alt="Marca 3" />
    </div>

    <div class="brand">
      <img src="/assets/stra.avif" alt="Marca 4" />
    </div>

    <div class="brand">
      <img src="/assets/cogni.avif" alt="Marca 5" />
    </div>

    <div class="brand">
      <img src="/assets/jabil.avif" alt="Marca 6" />
    </div>

  </div>

</section>

    <!-- HERO -->
    <section class="hero">

      <div class="hero-content">

        <span class="hero-label">
          LOGÍSTICA INDUSTRIAL
        </span>

        <h1>
          La refacción que necesitas.
          <span>Cuando la necesitas.</span>
        </h1>

        <p>
          SERVIX conecta a empresas con entregas rápidas de
          refacciones, materiales y componentes industriales.
          Pensado para esas urgencias donde esperar no es una opción.
        </p>

        <div class="hero-actions">

          <a href="#solicitar" class="hero-button">
            Solicitar entrega
          </a>


        </div>

      </div>

  
      <div class="hero-visual">
        <img
          src="/assets/logo.jpg"
          alt="SERVIX"
          class="hero-logo"
        />
      </div>
    </section>

   


<!-- SERVICIOS -->
<section class="services" id="servicios">

  <div class="section-header">

    <span class="section-label">
      ¿QUÉ MOVEMOS?
    </span>

    <h2>
      Lo que tu operación
      <span> necesita.</span>
    </h2>

    <p>
      Encontramos y trasladamos los componentes que necesitas
      para mantener tu operación en movimiento.
    </p>

  </div>


  <div class="services-grid">

    <article class="service-card">

      <!-- IMAGEN -->
      <div class="service-image">
        <img
          src="/assets/REF_AUT.avif"
          alt="Refacciones industriales"
        />
      </div>

      <h3>Refacciones</h3>

      <p>
        Refacciones industriales y automotrices para
        atender reparaciones y mantenimientos urgentes.
      </p>

    </article>


    <article class="service-card">

      <!-- IMAGEN -->
      <div class="service-image">
        <img
          src="/assets/MAT.avif"
          alt="Materiales industriales"
        />
      </div>


      <h3>Materiales</h3>

      <p>
        Materiales necesarios para continuar proyectos,
        mantenimientos y operaciones sin detenerte.
      </p>

    </article>


    <article class="service-card">

      <!-- IMAGEN -->
      <div class="service-image">
        <img
          src="/assets/comp.avif"
          alt="Componentes industriales"
        />
      </div>

  

      <h3>Componentes</h3>

      <p>
        Componentes especializados para resolver
        necesidades específicas de tu empresa.
      </p>

    </article>

  </div>

</section>

 <!-- CÓMO FUNCIONA -->
<section class="process-section" id="como-funciona">

  <div class="process-header">

    <span class="section-label">
      CÓMO FUNCIONA
    </span>

    <h2>
      Tú lo necesitas.
      <span>Nosotros lo movemos.</span>
    </h2>

    <p>
      Un proceso simple para resolver esas urgencias
      donde esperar no es una opción.
    </p>

  </div>


  <div class="process-track">


    <!-- PASO 01 -->
    <div class="process-item">

      <div class="process-image">
        <img
          src="/assets/soli.avif"
          alt="Solicitar una refacción"
        />
      </div>

      <div class="process-number">
        01
      </div>

      <div class="process-content">

        <span class="process-tag">
          PRIMER PASO
        </span>

        <h3>
          Solicita
        </h3>

        <p>
          Dinos qué necesitas, dónde está y dónde
          debe entregarse.
        </p>

      </div>

    </div>


    <div class="process-arrow">
      →
    </div>


    <!-- PASO 02 -->
    <div class="process-item">

      <div class="process-image">
        <img
          src="/assets/loca.avif"
          alt="Localización de una refacción"
        />
      </div>

      <div class="process-number">
        02
      </div>

      <div class="process-content">

        <span class="process-tag">
          SEGUNDO PASO
        </span>

        <h3>
          Localizamos
        </h3>

        <p>
          Encontramos la refacción o material que
          necesitas para continuar.
        </p>

      </div>

    </div>


    <div class="process-arrow">
      →
    </div>


    <!-- PASO 03 -->
    <div class="process-item">

      <div class="process-image">
        <img
          src="/assets/entre.avif"
          alt="Entrega de una refacción"
        />
      </div>

      <div class="process-number">
        03
      </div>

      <div class="process-content">

        <span class="process-tag">
          ÚLTIMO PASO
        </span>

        <h3>
          Entregamos
        </h3>

        <p>
          Coordinamos el traslado y lo llevamos
          hasta donde lo necesitas.
        </p>

      </div>

    </div>

  </div>




</section>
  </main>
  
    <Footer />

</Layout>

