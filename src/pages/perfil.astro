---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.jsx';
import prisma from '../lib/prisma';
import { createHash } from 'node:crypto';
import '../styles/perfil.css';

const session = Astro.cookies.get('servix_session');

if (!session?.value) {
  return Astro.redirect('/login');
}

// =========================
// HASH DEL TOKEN
// =========================

const tokenHash = createHash('sha256')
  .update(session.value)
  .digest('hex');

// =========================
// BUSCAR SESIÓN
// =========================

const sesion = await prisma.session.findUnique({
  where: {
    tokenHash,
  },
  select: {
    userId: true,
    expiresAt: true,
  },
});

// =========================
// SESIÓN NO EXISTE
// =========================

if (!sesion) {
  Astro.cookies.delete('servix_session', {
    path: '/',
  });

  return Astro.redirect('/login');
}

// =========================
// SESIÓN EXPIRADA
// =========================

if (sesion.expiresAt <= new Date()) {

  await prisma.session.delete({
    where: {
      tokenHash,
    },
  });

  Astro.cookies.delete('servix_session', {
    path: '/',
  });

  return Astro.redirect('/login');
}

// =========================
// BUSCAR USUARIO
// =========================

const usuario = await prisma.user.findUnique({
  where: {
    id: sesion.userId,
  },
  select: {
    id: true,
    nombre: true,
    email: true,
    emailVerified: true,
  },
});

// =========================
// USUARIO NO EXISTE
// =========================

if (!usuario) {

  Astro.cookies.delete('servix_session', {
    path: '/',
  });

  return Astro.redirect('/login');
}
---

<Layout>

  <Navbar
    client:load
    usuario={usuario}
  />

  <main class="perfil-page">

    <section class="perfil-container">

      <div class="perfil-header">

        <div class="perfil-avatar">
          {usuario.nombre.charAt(0).toUpperCase()}
        </div>

        <div>
          <p class="perfil-label">
            MI CUENTA
          </p>

          <h1>
            Hola, {usuario.nombre}
          </h1>

          <p class="perfil-email">
            {usuario.email}
          </p>
        </div>

      </div>


      <div class="perfil-grid">

        <!-- INFORMACIÓN -->

        <div class="perfil-card">

          <div class="perfil-card-header">

            <div>
              <span class="perfil-icon">
                👤
              </span>
            </div>

            <div>
              <h2>
                Información personal
              </h2>

              <p>
                Información de tu cuenta SERVIX
              </p>
            </div>

          </div>


          <div class="perfil-info">

            <div class="perfil-info-item">

              <span>
                Nombre
              </span>

              <strong>
                {usuario.nombre}
              </strong>

            </div>


            <div class="perfil-info-item">

              <span>
                Correo electrónico
              </span>

              <strong>
                {usuario.email}
              </strong>

            </div>


            <div class="perfil-info-item">

              <span>
                Estado del correo
              </span>

              {usuario.emailVerified ? (

                <strong class="perfil-verified">
                  ✓ Verificado
                </strong>

              ) : (

                <strong class="perfil-unverified">
                  ⚠ No verificado
                </strong>

              )}

            </div>

          </div>

        </div>


        <!-- SEGURIDAD -->

        <div class="perfil-card">

          <div class="perfil-card-header">

            <div>
              <span class="perfil-icon">
                🔐
              </span>
            </div>

            <div>
              <h2>
                Seguridad
              </h2>

              <p>
                Administra la seguridad de tu cuenta
              </p>
            </div>

          </div>


          <div class="perfil-actions">

            <a
              href="/recuperar-password"
              class="perfil-action"
            >
              <span>
                Cambiar contraseña
              </span>

              <span>
                →
              </span>
            </a>


            <button
              id="logout-button"
              class="perfil-logout"
            >
              <span>
                Cerrar sesión
              </span>

              <span>
                ↗
              </span>
            </button>

          </div>

        </div>

      </div>

    </section>

  </main>

  <Footer />

</Layout>


<script>
  const logoutButton =
    document.getElementById('logout-button');

  logoutButton?.addEventListener(
    'click',
    async () => {

      logoutButton.textContent =
        'Cerrando sesión...';

      try {

        const response = await fetch(
          '/api/logout',
          {
            method: 'POST',
          }
        );

        if (response.ok) {
          window.location.href = '/login';
          return;
        }

        logoutButton.textContent =
          'Cerrar sesión';

      } catch (error) {

        console.error(error);

        logoutButton.textContent =
          'Cerrar sesión';
      }

    }
  );
</script>

